{
  "name": "@co0ontty/wand",
  "version": "4.89.5-debug.t10101604",
  "description": "A web console for Claude Code, Codex, OpenCode, and other local CLI tools.",
  "type": "module",
  "bin": {
    "wand": "dist/cli.js"
  },
  "author": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "files": [
    "dist",
    "skills/wand-decision",
    "skills/wand-system",
    "browser-extension",
    "scripts/install-render-binary.js",
    "scripts/recover-web-update.sh",
    "scripts/recover-web-update.mjs",
    "scripts/update-node.sh",
    "scripts/update-target.js",
    "scripts/stage-render-binaries.js",
    "scripts/install-laya-runtime.js"
  ],
  "preferGlobal": true,
  "scripts": {
    "generate:web-assets": "node scripts/generate-web-assets.js",
    "build": "node src/deployment-lock.ts --run-project -- npm run build:body",
    "build:body": "node scripts/build-body.js",
    "build:copy-content": "cp -r src/web-ui/content dist/web-ui/ && cp src/decision-worker.py dist/decision-worker.py && node scripts/minify-dist-content.js",
    "build:render-bin": "node scripts/stage-render-binaries.js --all",
    "laya:install": "node scripts/install-laya-runtime.js",
    "build:render-native": "cargo build --release --manifest-path render/Cargo.toml -p wand-renderd",
    "build:structured-render-native": "cargo build --release --manifest-path render/Cargo.toml -p wand-structured-renderd",
    "dev": "node scripts/check-node-version.js && node scripts/bundle-tailwind.js && node scripts/bundle-xterm.js && node scripts/bundle-qrcode.js && node scripts/bundle-browser.js --development && npm run generate:web-assets && tsx src/cli.ts web",
    "check": "node src/deployment-lock.ts --run-project -- npm run check:body",
    "check:body": "node scripts/check-node-version.js && node scripts/bundle-tailwind.js && node scripts/bundle-xterm.js && node scripts/bundle-qrcode.js && node scripts/bundle-browser.js && npm run generate:web-assets && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p tsconfig.react.json",
    "typecheck": "node scripts/check-node-version.js && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p tsconfig.react.json",
    "test": "node scripts/check-node-version.js && node scripts/run-tests.js",
    "check:bundle-budget": "node scripts/check-node-version.js && node scripts/check-bundle-budget.js",
    "budget:accept": "node scripts/check-node-version.js && node scripts/check-bundle-budget.js --accept-baseline",
    "sync:brand-assets": "node scripts/sync-brand-assets.js",
    "check:brand-assets": "node scripts/sync-brand-assets.js --check",
    "audit:remnants": "node scripts/audit-legacy-remnants.js",
    "clean:build-cache": "node scripts/clean-build-cache.js",
    "clean:build-cache:auto": "node scripts/auto-clean-build-cache.js",
    "clean:build-cache:install": "node scripts/install-build-cache-cleanup.js",
    "prepublishOnly": "VER=${WAND_PUBLISH_VERSION:-$(git tag --sort=-v:refname --list 'v*' | head -1)} && VER=${VER#v} && npm version \"$VER\" --no-git-tag-version --allow-same-version && npm run build",
    "bundle:tailwind": "node scripts/bundle-tailwind.js"
  },
  "keywords": [
    "cli",
    "web",
    "automation",
    "developer-tools"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.81.0",
    "@earendil-works/chord": "1.0.2",
    "@earendil-works/pi-agent-core": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-codemode": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-mcp": "1.0.2",
    "@earendil-works/pi-telemetry": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "marked": "^18.0.14",
    "multer": "^2.1.1",
    "neo-blessed": "^0.2.0",
    "node-pty": "^1.1.0",
    "pi-agent-browser-native": "^0.9.6",
    "stream-chain": "4.2.5",
    "stream-json": "3.7.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@ant-design/x": "2.9.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.13.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.186.0",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "6.6.5",
    "esbuild": "^0.28.0",
    "fast-sha256": "1.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "three": "0.186.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
